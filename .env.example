# --- Vercel Analytics / Speed Insights ---
# Ambos ficam ATIVOS por padrão em produção (desligados apenas em localhost).
# Defina como "false" somente se quiser desativar a coleta.
VITE_ENABLE_WEB_ANALYTICS=true
VITE_ENABLE_SPEED_INSIGHTS=true

# --- AdSense ---
# Enquanto aguarda aprovação
VITE_ADSENSE_ENABLED=false

# Depois da aprovação
VITE_ADSENSE_ENABLED=true
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SLOT_TOP_BANNER=1234567890
VITE_ADSENSE_SLOT_SIDEBAR=0987654321
VITE_ADSENSE_SLOT_BOTTOM_BANNER=1122334455
